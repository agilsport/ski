    <col value="1"/>
    <row value="30px"/>
    <matrix row="auto">
      <col value="1,3,1"/>
      <row value="20px"/>
      <padding all="5px"/>
      <textctrl row="150px" col_start="2" style="TE_CENTER|TE_READONLY|TE_MULTILINE" name="race_name"><font size="10" weight="bold"/>
        <background mode="solid" color="ltgray"/>
      </textctrl>
      <row value="20px"/>
       <toolbar row="auto" col_start="1" col_end="0" name="tbconfig" style="TB_FLAT|TB_HORIZONTAL|TB_TEXT"/>
    </matrix>
  </panel>
 </root>
