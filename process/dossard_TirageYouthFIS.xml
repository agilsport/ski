<?xml version="1.0" encoding="UTF-8"?>
<!-- Matrice Individuelle PG -->
<!-- <background mode="gradient_line_vert" color_start="white" color_end="ltgray" /> -->
<root title="Tirage des dossards Courses FIS Jeunes">
  <panel name="column">
    <lua>
	</lua>
    <padding all="5px"/>
    <col value="1,1"/>
    <row value="10px"/>
	<statictext row="100px" col_start="1" col_end="0" font_size="12" font_weight="bold" style="ALIGN_CENTER" label="Double Tirage des Dossards pour les\nCourses Internationales Jeunes" />
 	<matrix row="auto" col_start="1" col_end="2">
		<col value="1,1,1"/>
 		<wndtext row="45px" col_start="2" font_size="10" align="right" ><background mode="solid" color="ltorange"/>"Choix de la colonne pour les groupes de tirage : "</wndtext>
		<combobox row="auto" col_start="2" name="column" style="ALIGN_CENTER"/>
		<checkbox row="auto" col_start="2" name="language" label="Cocher pour avoir les éditions en français" font_size="11" font_weight="bold" style="CHK_2STATE|ALIGN_LEFT"/>
		<checkbox row="auto" col_start="2" name="raz" label="Cocher pour tout effacer" font_size="11" font_weight="bold" style="CHK_2STATE|ALIGN_LEFT"/>
	</matrix>
	<row value="10px"/>
	<toolbar row="auto" col_start="1" col_end="0" name="tbcolumn" style="TB_FLAT|TB_HORIZONTAL|TB_TEXT"/>
   </panel>

  <panel name="config">
    <lua>
	</lua>
    <padding all="5px"/>
    <col value="1,1"/>
    <row value="10px"/>
	<statictext row="100px" col_start="1" col_end="0" font_size="12" font_weight="bold" style="ALIGN_CENTER" label="Double Tirage des Dossards pour les\nCourses Internationales Jeunes" />
    <matrix row="auto" col_start="1">
		<col value="1,150px,150px,150px,1"/>
  		<wndtext row="50px" col_start="2" col_end="4" font_size="10" align="center" ><background mode="solid" color="ltorange"/>"U14 Filles ("..params.nb_u14_filles..")"</wndtext>
		<wndtext row="50px" col_start="2" font_size="10" align="center"><background mode="solid" color="ltorange"/>"Groupe"</wndtext>
		<wndtext col_start="3" font_size="10" align="center"><background mode="solid" color="ltorange"/>"Nombre"</wndtext>
		<wndtext col_start="4" font_size="10" align="center"><background mode="solid" color="ltorange"/>"1er dossard"</wndtext>
		<lua>for i = 1, params.u14_filles do</lua>
			<textctrl row="auto" col_start="2" name="('u14_filles_groupe'..i)" style="TE_CENTER|TE_READONLY"/>
			<textctrl col_start="3" name="('u14_filles_nombre'..i)" style="TE_CENTER|TE_READONLY"/>
			<textctrl col_start="4" name="('u14_filles_dossard'..i)" style="TE_CENTER" cond="i==1"/>
		<lua>end</lua>
	  
      <row value="20px"/>
	</matrix>
    <matrix row="auto" col_start="2" row_start="-1">
		<col value="1,150px,150px,150px,1"/>
 		<wndtext row="50px" col_start="2" col_end="4" font_size="10" align="center" ><background mode="solid" color="ltorange"/>"U14 Garçons ("..params.nb_u14_garcons..")"</wndtext>
		<wndtext row="50px" col_start="2" font_size="10" align="center"><background mode="solid" color="ltorange"/>"Groupe"</wndtext>
		<wndtext col_start="3" font_size="10" align="center"><background mode="solid" color="ltorange"/>"Nombre"</wndtext>
		<wndtext col_start="4" font_size="10" align="center"><background mode="solid" color="ltorange"/>"1er dossard"</wndtext>
		<lua>for i = 1, params.u14_garcons do</lua>
			<textctrl row="auto" col_start="2" name="('u14_garcons_groupe'..i)" style="TE_CENTER|TE_READONLY"/>
			<textctrl col_start="3" name="('u14_garcons_nombre'..i)" style="TE_CENTER|TE_READONLY"/>
			<textctrl col_start="4" name="('u14_garcons_dossard'..i)" style="TE_CENTER" cond="i==1"/>
		<lua>end</lua>
	  
      <row value="20px"/>
	</matrix>
 
   <matrix row="auto" col_start="1">
		<col value="1,150px,150px,150px,1"/>
 		<wndtext row="50px" col_start="2" col_end="4" font_size="10" align="center" ><background mode="solid" color="ltorange"/>"U16 Filles ("..params.nb_u16_filles..")"</wndtext>
		<wndtext row="50px" col_start="2" font_size="10" align="center"><background mode="solid" color="ltorange"/>"Groupe"</wndtext>
		<wndtext col_start="3" font_size="10" align="center"><background mode="solid" color="ltorange"/>"Nombre"</wndtext>
		<wndtext col_start="4" font_size="10" align="center"><background mode="solid" color="ltorange"/>"1er dossard"</wndtext>
		<lua>for i = 1, params.u16_filles do</lua>
			<textctrl row="auto" col_start="2" name="('u16_filles_groupe'..i)" style="TE_CENTER|TE_READONLY"/>
			<textctrl col_start="3" name="('u16_filles_nombre'..i)" style="TE_CENTER|TE_READONLY"/>
			<textctrl col_start="4" name="('u16_filles_dossard'..i)" style="TE_CENTER" cond="i==1"/>
		<lua>end</lua>
	  
      <row value="20px"/>
	</matrix>
    <matrix row="auto" col_start="2" row_start="-1">
		<col value="1,150px,150px,150px,1"/>
 		<wndtext row="50px" col_start="2" col_end="4" font_size="10" align="center" ><background mode="solid" color="ltorange"/>"U16 Garçons ("..params.nb_u16_garcons..")"</wndtext>
		<wndtext row="50px" col_start="2" font_size="10" align="center"><background mode="solid" color="ltorange"/>"Groupe"</wndtext>
		<wndtext col_start="3" font_size="10" align="center"><background mode="solid" color="ltorange"/>"Nombre"</wndtext>
		<wndtext col_start="4" font_size="10" align="center"><background mode="solid" color="ltorange"/>"1er dossard"</wndtext>
		<lua>for i = 1, params.u16_garcons do</lua>
			<textctrl row="auto" col_start="2" name="('u16_garcons_groupe'..i)" style="TE_CENTER|TE_READONLY"/>
			<textctrl col_start="3" name="('u16_garcons_nombre'..i)" style="TE_CENTER|TE_READONLY"/>
			<textctrl col_start="4" name="('u16_garcons_dossard'..i)" style="TE_CENTER" cond="i==1"/>
		<lua>end</lua>
	  
		<row value="20px"/>
	</matrix>
	<row value="10px"/>
	<toolbar row="auto" col_start="1" col_end="0" name="tbconfig" style="TB_FLAT|TB_HORIZONTAL|TB_TEXT"/>
   </panel>

  <panel id="print">
	<lua>dofile('./interface/adv.lua');
		language = params.Langue or 'fr';
		dofile('./edition/traductionPG.lua');
		params.Draw = params.Draw or 0;
		categ = tostring(params.Categ) or '';
		sexe = tostring(params.Sexe) or '';
		if sexe == 'F' then sexe = 'Filles' else sexe = 'Garçons' end
	</lua>
    <layers>
      <layer id="FIS-GM"/>
    </layers>
    <header>
		  <col value="1"/>
		  <spacing all="0"/>
		  <padding all="0"/>
		  <pen border="none"/>
		  <font name="Calibri" size="13" adjust="width" weight="bold"/>
		  <text row="auto" col_start="1" align="center">params.Nom</text>
		  <text row="auto" col_start="1" align="center">traduction(language,'Double tirage au sort des dossards pour les groupes 1 et 2')..'\n'..traduction(language, 'Les deux tirages sont faits par deux méthodes différentes')</text>
		  <text row="auto" col_start="1" align="center">traduction(language, 'Impression pour les ')..categ..' '..traduction(language, sexe)</text>
    </header>
    <first_header>
		<row value="0.6cm"/>
		<font name="Calibri" size="10" adjust="ellipsize" weight="normal"/>
		<col value="1"/>
		<text row="0.6cm" font_weight="bold" cond="params.Draw &gt; 0" font_size_step="1">traduction(language, 'Impression des tables de tirage pour le groupe ')..params.Draw</text>
		<text row="0.6cm" font_weight="bold" cond="params.Draw == 0" font_size_step="1">traduction(language, 'Impression des tables de tirage')</text>
		<text row="0.6cm" font_weight="bold" font_size_step="1">traduction(language, '1. Table des dossards (par mélange de Fisher-Yates)')..' '..traduction(language, 'Tirage 1 : il y a ')..#params.TableDossards..traduction(language, ' dossards à affecter')</text>
		<row value="0.3cm"/>
		<pen border="all"/>
		<matrix row="auto" col_start="1">
			<col value="7cm,1cm"/>
			<lua>for i = 1, #params.TableDossards do</lua>
				<background color="white" mode="solid" cond="i%2 == 0"/>
				<background color="ltgray" mode="solid" cond="i%2 == 1"/>
				<text row="0.5cm" col_start="1" align="left">traduction(language, 'dossard du rang fictif ')..i</text>
				<text col_start="2" align="center">tostring(params.TableDossards[i])</text>
			<lua>end</lua>
		</matrix>
		<pen border="none"/>
		<row value="0.3cm"/>
		<text row="0.6cm" col_start="1" font_weight="bold" font_size_step="1">traduction(language, '2. Tirage au sort du rang fictif des coureurs (tirage aléatoire "sans remise")')</text>
		<row value="0.3cm"/>
		<pen border="all"/>
    </first_header>
    <footer>
      <background mode="transparent"/>
      <font name="Calibri" size="8" adjust="width" weight="normal"/>
      <pen border="none"/>
      <text row="auto" col="1" align="left"/>
      <line col_start="1" col_end="0" pen_size="2" pen_color="dkgray" border="bottom"/>
      <row value="auto"/>
      <matrix col_start="1">
        <row value="auto"/>
        <text col="auto" align="left">app.GetName()..' Version '..app.GetVersion()..' / FFS'</text>
        <image col="0.4cm" adjust="width" align="left">'./res/32x32_ffs.png'</image>
        <text col="auto" align="left">' / Agil Informatique'</text>
        <image col="0.4cm" adjust="width" align="left">'./res/32x32_agil.png'</image>
        <text col="auto" align="left">'/ Ph.Guérindon (v '..params.Version..')'..os.date(' / Edition du %d-%m-%Y à %H:%M:%S')</text>
      </matrix>
    </footer>
	<body>
		<font weight="bold"/>
		<call option="color_alternate" file="./edition/options.xml" />
        <col value="7cm,2cm,3.5cm,4cm"/>
		<text row="0.5cm" col_start="1" label="(traduction(language, 'Identité'))" align="left">$(Order_racer)..'. '..$(Racer_identity)</text>
		<!-- <text row="0.5cm" col_start="1" label="(traduction(language, 'Identité'))" align="left" cond="row &lt; 9">$(Order_racer)..'. '..$(Racer_identity)</text> -->
		<!-- <text row="0.5cm" col_start="1" label="(traduction(language, 'Identité'))" align="left" cond="row &gt;= 9">$(Order_racer)..'. '..$(Racer_identity)</text> -->
		<text col_start="2" label="Nation" align="center">$(Racer_nation)</text>
		<text col_start="3" label="(traduction(language, 'Rang fictif'))" align="center">$(Racer_fictionnal_rank)</text>
		<text col_start="4" label="(traduction(language, 'Dossard correspondant'))" align="center">$(Racer_matching_bib)</text>
	</body>
  </panel>
</root>
