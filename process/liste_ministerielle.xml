<?xml version="1.0" encoding="UTF-8"?>
<!-- Editions pour les listes ministérielles hait-niveau -->
<!-- <background mode="gradient_line_vert" color_start="white" color_end="ltgray" /> -->
<!-- <font name="Calibri" size="10" /> -->
<root>
  <panel name="backoffice">
	<wnd name="statictext" style="ALIGN_CENTER" />
    <lua>dofile('./interface/adv.lua')</lua>
    <padding all="10px"/>
    <col value="1"/>
	<font size="10" />
    <statictext row="auto" font_size="12" col_start="1" col_end="0" align="right" label="Back Office - gestion des critères"/>
    <row value="5px"/>
    <matrix row="auto">
      <row value="5px"/>
      <col value="1,1,1,1"/>
      <statictext row="auto" col_start="2" style="ALIGN_RIGHT" label="Niveau étudié"/>
      <combobox col_start="3" name="comboNiveau" style="CB_READONLY"/>
      <statictext row="auto" col_start="2" style="ALIGN_RIGHT" label="Sexe des coureurs"/>
      <combobox col_start="3" name="comboSexe" style="CB_READONLY"/>
      <statictext row="50px" font_size="12" col_start="1" col_end="0" label="Indiquer les classements mondiaux selon les critères à définir."/>
    </matrix>
     <row value="5px"/>
    <matrix row="auto">
      <col value="1,1,1,50px,1,1,1,1,1,1"/>
 	  <padding all="3px" />
      <statictext row="50px" col_start="1" label="Année"/>
      <statictext col_start="2" col_end="3" label="Discipline Technique"/>
      <statictext col_start="5" col_end="6" align="center" label="Discipline Vitesse"/>
      <statictext col_start="7" col_end="10" label="Prendre 2 Disciplines :  Technique ET Vitesse"/>
      <statictext row="auto" col_start="2" col_end="3" label="Clt / année d\'âge OU Clt mondial"/>
      <statictext col_start="4" label="OU"/>
      <statictext col_start="5" col_end="6" label="Clt / année d\'âge OU Clt mondial"/>
      <statictext col_start="7" col_end="8" label="Clt / année d\'âge OU Clt mondial"/>
      <statictext col_start="9" col_end="10" label="Clt / année d\'âge OU Clt mondial"/>
      <row value="5px"/>
      <lua>for i = 1, 10 do</lua>
      <textctrl row="auto" col_start="1" align="center" name="('annee'..i)" style="TE_READONLY|TE_CENTER"/>
      <textctrl col_start="2" align="center" name="('unetechniquea'..i)" style="TE_CENTER"/>
      <textctrl col_start="3" align="center" name="('unetechniqueb'..i)" style="TE_CENTER"/>
      <checkbox col_start="4" name="('chkouc2b'..i)" label="" style="CHK_2STATE|ALIGN_RIGHT"/>
      <textctrl col_start="5" align="center" name="('unevitessea'..i)" style="TE_CENTER"/>
      <textctrl col_start="6" align="center" name="('unevitesseb'..i)" style="TE_CENTER"/>
      <textctrl col_start="7" align="center" name="('deuxvitessea'..i)" style="TE_CENTER"/>
      <textctrl col_start="8" align="center" name="('deuxvitesseb'..i)" style="TE_CENTER"/>
      <textctrl col_start="9" align="center" name="('deuxtechniquea'..i)" style="TE_CENTER"/>
      <textctrl col_start="10" align="center" name="('deuxtechniqueb'..i)" style="TE_CENTER"/>
      <lua>end</lua>
      <row value="5px"/>
    </matrix>
    <row value="30px"/>
    <toolbar row="auto" col_start="1" col_end="0" name="tbedit1" style="TB_FLAT|TB_HORIZONTAL|TB_TEXT"/>
  </panel>
  <panel name="configgenerale">
    <lua>dofile('./interface/adv.lua')</lua>
	<wnd name="statictext" style="ALIGN_CENTER" />
    <padding all="3px"/>
    <col value="1,3,1"/>
    <statictext row="50px" col_start="2" align="center" label="Aide à l\'établissement des listes ministérielles haut niveau"/>
    <matrix col_start="2" row="auto">
      <row value="5px"/>
      <col value="1,2,2,1"/>
      <statictext row="auto" col_start="2" style="ALIGN_RIGHT" label="Liste FIS support"/>
      <combobox col_start="3" name="comboListe" style="CB_READONLY"/>
      <statictext row="auto" col_start="2" style="ALIGN_RIGHT" label="Niveau étudié"/>
      <combobox col_start="3" name="comboNiveau" style="CB_READONLY"/>
      <statictext row="auto" col_start="2" style="ALIGN_RIGHT" label="Sexe des coureurs"/>
      <combobox col_start="3" name="comboSexe" style="CB_READONLY"/>
      <statictext row="auto" col_start="2" style="ALIGN_RIGHT" label="Année de début"/>
      <combobox col_start="3" name="comboAnneeDebut" style="CB_READONLY"/>
      <statictext row="auto" col_start="2" style="ALIGN_RIGHT" label="Année de fin"/>
      <combobox col_start="3" name="comboAnneeFin" style="CB_READONLY"/>
      <row value="20px"/>
    </matrix>
    <row value="5px"/>
    <matrix row="auto" col_start="2">
      <padding all="10px"/>
      <col value="1,1,2,1,2"/>
      <row value="20px"/>
      <row value="10px"/>
      <!-- Critère 1 : 1 discipline technique -->
      <statictext row="auto" style="ALIGN_RIGHT" col_start="2" label="être dans les"/>
      <textctrl col_start="3" align="center" name="gxpremiersc1a" style="TE_CENTER"/>
      <statictext col_start="4" style="ALIGN_LEFT" label="mondiaux"/>
      <checkbox col_start="5" name="chkc1a" label="Par année d\'âge" style="CHK_2STATE|ALIGN_LEFT"/>
      <checkbox row="auto" col_start="1" name="chkouc1b" label="OU" style="CHK_2STATE|ALIGN_RIGHT"/>
      <statictext col_start="2" style="ALIGN_RIGHT" label="être dans les"/>
      <textctrl col_start="3" name="gxpremiersc1b" style="TE_CENTER"/>
      <statictext col_start="4" style="ALIGN_LEFT" label="mondiaux"/>
      <checkbox col_start="5" name="chkc1b" label="Par année d\'âge" style="CHK_2STATE|ALIGN_LEFT"/>
     <row value="10px"/>
      <staticbox row_start="-5" row_end="0" col_start="1" col_end="0" label="1 Discipline technique"/>
    </matrix>
    <row value="5px"/>
    <matrix row="auto" col_start="2">
      <padding all="10px"/>
      <col value="1,1,2,1,2"/>
      <row value="20px"/>
      <row value="10px"/>
      <!-- Critère 2 : 1 discipline vitesse -->
      <checkbox row="auto" col_start="1" name="chkouc2a" label="OU" style="CHK_2STATE|ALIGN_RIGHT"/>
      <statictext col_start="2" style="ALIGN_RIGHT" label="être dans les"/>
      <textctrl col_start="3" name="gxpremiersc2a" style="TE_CENTER"/>
      <statictext col_start="4" style="ALIGN_LEFT" label="mondiaux"/>
      <checkbox col_start="5" name="chkc2a" label="Par année d\'âge" style="CHK_2STATE|ALIGN_LEFT"/>
      <checkbox row="auto" col_start="1" name="chkouc2b" label="OU" style="CHK_2STATE|ALIGN_RIGHT"/>
      <statictext col_start="2" style="ALIGN_RIGHT" label="être dans les"/>
      <textctrl col_start="3" name="gxpremiersc2b" style="TE_CENTER"/>
      <statictext col_start="4" style="ALIGN_LEFT" label="mondiaux"/>
      <checkbox col_start="5" name="chkc2b" label="Par année d\'âge" style="CHK_2STATE|ALIGN_LEFT"/>
      <row value="10px"/>
      <staticbox row_start="-4" row_end="0" col_start="1" col_end="0" label="1 Discipline vitesse"/>
    </matrix>
    <row value="10px"/>
    <row value="10px"/>
    <matrix row="auto" col_start="2">
      <col value="1,1,2,1,2"/>
      <row value="20px"/>
      <row value="10px"/>
      <!-- Critère 3 : 1 discipline vitesse ET une discipline technique -->
      <statictext row="auto" col_start="1" col_end="2" style="ALIGN_RIGHT" label="En Technique être dans les"/>
      <textctrl col_start="3" name="gxpremiersc3a" style="TE_CENTER"/>
      <statictext col_start="4" style="ALIGN_LEFT" label="mondiaux"/>
      <checkbox col_start="5" name="chkc3a" label="Par année d\'âge" style="CHK_2STATE|ALIGN_LEFT"/>
      <statictext row="auto" col_start="2" label="ET"/>
      <statictext row="auto" col_start="1" col_end="2" style="ALIGN_RIGHT" label="En Vitesse être dans les"/>
      <textctrl col_start="3" name="gxpremiersc3b" style="TE_CENTER"/>
      <statictext col_start="4" style="ALIGN_LEFT" label="mondiaux"/>
      <checkbox col_start="5" name="chkc3b" label="Par année d\'âge" style="CHK_2STATE|ALIGN_LEFT"/>
      <row value="10px"/>
      <staticbox row_start="-6" row_end="0" col_start="1" col_end="0" label="1 Discipline vitesse ET une discipline technique"/>
    </matrix>
    <row value="5px"/>
    <toolbar row="auto" col_start="1" col_end="0" name="tbedit1" style="TB_FLAT|TB_HORIZONTAL|TB_TEXT"/>
  </panel>
  <panel id="printanalyse">
    <layers>
      <layer id="ffs">
        <matrix>
          <row value="0.5cm, 0.8cm"/>
          <col value="2cm, 1, 2cm"/>
          <image col_start="2" align="center" adjust="width">
            <background mode="transparent"/>'./logo/bandeau_fis.png'</image>
        </matrix>
        <matrix>
          <row value="0.4cm, 1.2cm"/>
          <col value="0.4cm, 1.2cm"/>
          <image align="center" adjust="width">
            <background mode="transparent"/>'./logo/logo_ffs.jpg'</image>
        </matrix>
        <matrix>
          <row value="0.4cm, 1.2cm"/>
          <col value="1, 1.2cm"/>
          <image align="center" adjust="width">
            <background mode="transparent"/>'./logo/logo_fis.jpg'</image>
          <col value="0.4cm"/>
        </matrix>
      </layer>
    </layers>
    <lua>dofile('./edition/functionPG.lua'); coureurs_critere = 0; somme_critere = 0;</lua>
    <header>
      <padding all="1px"/>
      <spacing all="2"/>
      <col value="1"/>
      <pen border="none"/>
      <font name="Calibri" size="13" adjust="width" weight="bold"/>
      <text row="auto" align="center">'Analyse des performances pour la liste '..params.Liste..params.Niveau..' (de '..params.AnneeDebut..' à '..params.AnneeFin..')\nLes critères s\'appliquent en cascade (si un critère n\'est pas rempli, on passe au suivant).'</text>
      <text row="auto" align="center">'Les coureurs sont triés par critères remplis puis par ordre de leurs meilleurs points en disciplines techniques.'</text>
      <row value="0.5cm"/>
      <font name="Calibri" size="12" adjust="width" weight="bold"/>
      <text row="auto">'Critère 1 : '..params.Critere1..' en discipline technique'</text>
      <text row="auto">'Critère 2 : '..params.Critere2..' en discipline vitesse'</text>
      <text row="auto">'Critère 3 : '..params.Critere3</text>
      <row value="0.5cm"/>
    </header>
    <footer>
      <background mode="transparent"/>
      <font name="Calibri" size="8" adjust="width" weight="normal"/>
      <pen border="none"/>
      <text row="auto" col="1" align="left"/>
      <line col_start="1" col_end="0" pen_size="2" pen_color="dkgray" border="bottom"/>
      <row value="auto"/>
      <matrix col_start="1">
        <row value="auto"/>
        <text col="auto" align="left">app.GetName()..' Version '..app.GetVersion()..' / FFS'</text>
        <image col="0.4cm" adjust="width" align="left">'./res/32x32_ffs.png'</image>
        <text col="auto" align="left">' / Agil Informatique'</text>
        <image col="0.4cm" adjust="width" align="left">'./res/32x32_agil.png'</image>
        <text col="auto" align="left">os.date(' - Philippe Guérindon / Edition du %d-%m-%Y à %H:%M:%S')</text>
        <text col="auto" align="left">' / sript LUA version '..params.Version</text>
      </matrix>
      <text align="right">string.format('Page %d/%s',editor:GetPageCurrent(), editor:GetPageCountLabel())</text>
      <line col_start="1" col_end="0" border="top"/>
    </footer>
    <label>
      <padding all="0"/>
      <spacing all="10"/>
      <pen border="all"/>
      <background color="white" mode="solid"/>
      <font name="Calibri" size="10" adjust="width" weight="bold"/>
      <col value="3,1,1,1+50px,1+50px,2,2,1+50px,1"/>
      <text row="auto" col_start="1" align="center">'Identité'</text>
      <text col_start="2" align="center">'Année'</text>
      <text col_start="3" align="center">'Comité'</text>
      <text col_start="4" align="center">'Pts/Clt Tech.'</text>
      <text col_start="5" align="center">'Pts/Clt Vit.'</text>
      <text col_start="6" align="center">'Pts/Clt Tech./année)'</text>
      <text col_start="7" align="center">'Pts/Clt Vit./année)'</text>
      <text col_start="8" align="center">'Critères remplis'</text>
      <text col_start="9" align="center">'Nb.Critère'</text>
    </label>
  <body>
		<lua>txtTech = ''; txtTechAnnee = ''; txtVit = ''; txtVitAnnee = '';
		if string.find(body:GetCell('Col5', row), 'A') then txtTech = ' - X'; end
		if string.find(body:GetCell('Col5', row), 'C') then txtTechAnnee = ' - X'; end		
		if string.find(body:GetCell('Col5', row), 'B') then txtVit = ' - X'; end
		if string.find(body:GetCell('Col5', row), 'D') then txtVitAnnee = ' - X'; end
		</lua>
		<padding all="0"/>
		<pen border="all"/>
		<col value="3,1,1,1+50px,1+50px,2,2,1+50px,1"/>
		<font name="Calibri" size_step="-1" adjust="width" weight="normal"/>
		<background color="white" mode="solid" cond="row%2 == 0"/>
		<background color="ltgray" mode="solid" cond="row%2 == 1"/>
		<lua>if body:GetCellInt('Est_critere',row) &gt; 0 then coureurs_critere = coureurs_critere + 1; end</lua>
		<text row="auto" col_start="1">
		<font weight="bold" cond="body:GetCellInt('Est_critere', row) &gt; 0"/>$(Identite)</text>
		<text col_start="2" align="center">
		<font weight="bold" cond="body:GetCellInt('Est_critere', row) &gt; 0"/>$(An)</text>
		<text col_start="3" align="center">
		<font weight="bold" cond="body:GetCellInt('Est_critere', row) &gt; 0"/>$(Comite)</text>
		<text col_start="4" align="center" cond="body:GetCellInt('Col1', row) == 0">
		$(Pts_technique)..' / '..$(Clt_technique)..$(Best_tech)..txtTech</text>
		<text col_start="4" align="center" cond="body:GetCellInt('Col1', row) == 1">
		<font weight="bold" color="green"/>$(Pts_technique)..' / '..$(Clt_technique)..$(Best_tech)..txtTech</text>
		<text col_start="5" align="center" cond="body:GetCellInt('Col2', row) == 0">
		$(Pts_vitesse)..' / '..$(Clt_vitesse)..$(Best_vit)..txtVit</text>
		<text col_start="5" align="center" cond="body:GetCellInt('Col2', row) == 1">
		<font weight="bold" color="green"/>$(Pts_vitesse)..' / '..$(Clt_vitesse)..$(Best_vit)..txtVit</text>
		<text col_start="6" align="center" cond="body:GetCellInt('Col3', row) == 0">
		$(Pts_technique)..' / '..$(Clt_technique_annee)..txtTechAnnee</text>
		<text col_start="6" align="center" cond="body:GetCellInt('Col3', row) == 1">
		<font weight="bold" color="green"/>$(Pts_technique)..' / '..$(Clt_technique_annee)..$(Best_tech_annee)..txtTechAnnee</text>
		<text col_start="7" align="center" cond="body:GetCellInt('Col4', row) == 0">
		$(Pts_vitesse)..' / '..$(Clt_vitesse_annee)..txtVitAnnee</text>
		<text col_start="7" align="center" cond="body:GetCellInt('Col4', row) == 1">
		<font weight="bold" color="green"/>$(Pts_vitesse)..' / '..$(Clt_vitesse_annee)..$(Best_vit_annee)..txtVitAnnee</text>
		<text col_start="8" align="center">string.gsub($(Col5), ",[A-D]", "")</text>
		<!-- <text col_start="8" align="center">$(Col5)</text> -->
		<text col_start="9" align="center" >
		<font weight="bold"/>$(Est_critere)</text>
		<lua>somme_critere = somme_critere + body:GetCellInt('Est_critere', row);</lua>
		<lua>if row == body:GetNbRows() -1 then</lua>
			<text row="auto" col_start="9" align="center"><font size="10" weight="bold"/>"Total = "..somme_critere</text>
		<lua>end</lua>
   </body>
    <end>
      <col value="1"/>
      <row value="0.5cm"/>
      <text row="auto" cond="coureurs_critere &gt; 1">
        <font name="Calibri" size="11" weight="bold"/>coureurs_critere..' coureurs ont rempli les critères.'</text>
      <text row="auto" cond="coureurs_critere == 1">
        <font name="Calibri" size="11" weight="bold"/>coureurs_critere..' coureur a rempli les critères.'</text>
      <text row="auto" cond="coureurs_critere == 0">
        <font name="Calibri" size="11" weight="bold"/>'aucun coureur a rempli les critères.'</text>
    </end>
  </panel>
</root>
